# 실제 값은 .env.local 에 넣는다 (git 무시됨). 이 파일은 키 목록 견본.
#   cp .env.example .env.local

NEXT_PUBLIC_API_BASE_URL=https://toyou-server-development.onrender.com
NEXT_PUBLIC_KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback
# Apple 웹 Services ID (iOS Bundle ID 아님) · 등록된 Return URL (마지막 / 포함)
NEXT_PUBLIC_APPLE_WEB_CLIENT_ID=com.toyou.letters.web
NEXT_PUBLIC_APPLE_WEB_REDIRECT_URI=https://to-you-client.vercel.app/
